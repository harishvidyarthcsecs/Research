% ============================================================================
\chapter{Proposed Method: Verify-or-Reject Grounding}

\section{Definitions}
\begin{itemize}
  \item A stage is \textbf{scored-grounded} if it emits output alongside a
        confidence signal that a downstream consumer may act on or ignore.
  \item A stage is \textbf{verify-or-reject grounded} if its output type itself
        excludes unverifiable content, either because the stage is deterministic
        over verified inputs, or because an explicit step discards non-conforming
        output before it can propagate.
  \item Scored grounding is a property of the output, inspectable but skippable.
        Verify-or-reject grounding is a property of the pipeline, which a
        downstream stage cannot bypass by ignoring a score it was never given.
  \item This is the reject-by-default logic of the fail-safe-defaults principle
        in classical protection-system design, applied to citation grounding
        instead of access control.
\end{itemize}

\section{The Certification Algorithm}
\textsc{VoRG-Certify} compiles the evidence table into a hash index once, then
certifies the whole narrative in a single pass. Certification cost then scales
with the size of the narrative and the evidence table separately, not with their
product.

\begin{algorithm}[H]
\caption{\textsc{VoRG-Certify}: linear-time verify-or-reject narrative certification}
\begin{algorithmic}[1]
\Require Evidence table $E=\{e_1,\dots,e_n\}$, each row keyed by a unique citation key $\kappa(e_i)$; narrative $N=(s_1,\dots,s_m)$
\Ensure Certified narrative $N'$ with only sentences whose citations resolve to $E$; rejection log $R$
\Function{BuildIndex}{$E$}
  \State $H \gets$ empty hash map
  \For{each $e_i \in E$} \State $H[\kappa(e_i)] \gets e_i$ \Comment{expected $O(1)$ insert} \EndFor
  \State \Return $H$
\EndFunction
\Function{Certify}{$N$, $H$}
  \State $N' \gets \emptyset$;\ \ $R \gets \emptyset$
  \For{each sentence $s_j \in N$} \Comment{single pass}
    \State $K_j \gets \Call{ExtractKeys}{s_j}$ \Comment{one regex scan}
    \If{$K_j = \emptyset$} \State $R \gets R \cup \{(s_j, \textsc{NoClaim})\}$
    \ElsIf{$\exists\,k \in K_j$ with $k \notin H$} \State $R \gets R \cup \{(s_j, \textsc{Unresolved})\}$ \Comment{build error}
    \Else \State $N' \gets N' \cup \{s_j\}$
    \EndIf
  \EndFor
  \State \Return $(N', R)$
\EndFunction
\end{algorithmic}
\end{algorithm}

\section{Complexity}
Let $n=|E|$, let $m$ be the number of generated sentences, and let
$M=\sum_{j=1}^{m}|s_j|$ be the total narrative length.
\[
T(n,M) = O(n + M) \quad \text{expected time}, \qquad S(n,m) = O(n + m) \quad \text{auxiliary space}.
\]
\begin{itemize}
  \item \textsc{BuildIndex} performs $n$ hash insertions.
  \item \textsc{Certify} makes one linear pass; key extraction contributes
        $O(M)$ across all sentences and each lookup is expected $O(1)$.
  \item The naive linear-scan alternative, checking every sentence against every
        evidence row, costs $O(n \cdot m)$. The hash-indexed design removes this
        quadratic term.
  \item The same index-then-certify structure applies to contradiction judgments
        (indexed by claim-pair key) and journal-metadata fields (indexed by
        source), so the bound extends to those subsystems.
\end{itemize}

\begin{table}[H]
\centering
\caption{Scored grounding versus verify-or-reject grounding.}
\label{tab:contrast}
\begin{tabular}{@{}p{3.4cm}p{5.0cm}p{5.0cm}@{}}
\toprule
\headrow \hd{} & \hd{Scored grounding} & \hd{Verify-or-reject grounding} \\
\midrule
Unverifiable output & Emitted with a low score or flag & Not emitted; build error raised \\
Downstream dependence & Consumer must check the score & Consumer receives only verified output \\
Aggregation steps & Often LLM-driven, itself a hallucination source & Deterministic where possible, no new LLM surface \\
Failure visibility & Silent unless the score is inspected & Explicit, logged rejection \\
\bottomrule
\end{tabular}
\end{table}

% ============================================================================
\chapter{Implementation}

\section{Stack}
\begin{itemize}
  \item Language and framework: Python, Flask web interface.
  \item Model provider: Groq, model \texttt{openai/gpt-oss-120b}, temperature
        0.0 by default and 0.3 where a synthesis call sets its own.
  \item Storage: JSON for run state; a relational schema per external
        journal-quality source, joined on ISSN.
\end{itemize}

\section{Verify-or-Reject Mechanics}
\begin{itemize}
  \item \textbf{Evidence extraction.} An LLM proposes a structured row plus a
        supporting sentence. The sentence is trusted only if it is a normalised
        substring of the abstract. In reject mode a paraphrase-only row is not
        admitted; a deterministic rule extractor is used instead.
  \item \textbf{Synthesis matrix.} A methods-by-datasets grid built with no LLM
        call, classifying each cell as agreement, conflict, or blank.
  \item \textbf{Narrative verifier.} Every generated sentence must carry a
        citation key that resolves to a verified row. An unresolved sentence is
        a build error, not a warning.
\end{itemize}

\section{Evaluation Harness}
\begin{itemize}
  \item \texttt{run\_eval} runs the frozen corpus in three modes: \texttt{llm}
        (gate on), \texttt{pattern} (rule-based extraction, gate on), and
        \texttt{scored} (the matched ablation, gate replaced by a grounding
        score, nothing dropped).
  \item Downstream-error metrics: unsupported sentences reaching the final
        narrative, retained false-positive contradictions, and narrative build
        failed.
  \item \texttt{snapshot\_topic} freezes a corpus and backfills missing
        abstracts from Semantic Scholar and OpenAlex, then records abstract
        coverage.
  \item \texttt{run\_matrix} runs every topic-by-mode-by-repeat cell and
        aggregates per-topic mean and standard deviation with the repository
        commit hash.
\end{itemize}

