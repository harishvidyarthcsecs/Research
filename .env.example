# Environment variables for Autonomous Research Agent System

# Storage settings
STORAGE_PATH=data/memory
OUTPUT_PATH=output

# API Keys (optional - for enhanced functionality)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
PUBMED_API_KEY=your_pubmed_api_key_here

# Agent settings
MAX_PAPERS_PER_SOURCE=50
MAX_CONCURRENT_REQUESTS=5

# Processing settings
CLAIM_CONFIDENCE_THRESHOLD=0.5
CONTRADICTION_THRESHOLD=0.7

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=research_system.log
# LLM providers (configure at least one, or use deterministic rule modes)
XAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=

# Per-agent mode overrides
TOPIC_MODE=
CONTRADICTION_MODE=
GAP_MODE=
LITERATURE_MODE=
RECOMMENDATION_MODE=
# Required for /api/admin/* journal coverage and ETL endpoints.
# Generate a long random value and send it in the X-Admin-Token header.
ADMIN_TOKEN=
